[Unit]
Description=Ouro Postgres and Codex containers
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=__REPOSITORY__
ExecStart=/usr/bin/docker compose up -d --no-build --wait postgres codex
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target

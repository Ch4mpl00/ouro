module witnesses {
  import protocol.* from "./protocol"
  export protocol.*

  run ambiguousTest = init.then(saveVersion).then(activateWith(Set(1)))
    .then(startWith(Set(0), Set(0)))
    .then(prepareWith(Set(0), Set(0), Set(2)))
    .then(tickWith(Set(30000))).then(claimWith(Set(0), Set(1)))
    .then(prepareWith(Set(1), Set(0), Set(0)))
    .expect(ambiguousWitness and takeoverWitness and s.seen.contains("unknown") and safety)

  run sendCrashTest = init.then(saveVersion).then(activateWith(Set(1)))
    .then(startWith(Set(0), Set(0)))
    .then(prepareWith(Set(0), Set(0), Set(0))).then(sendWith(Set(0)))
    .then(crashWith(Set(0))).then(tickWith(Set(30000)))
    .then(claimWith(Set(0), Set(1))).then(prepareWith(Set(1), Set(0), Set(0)))
    .expect(sendCrashWitness and s.seen.contains("unknown") and safety)

  run listenersTest = init.then(saveVersion).then(activateWith(Set(1)))
    .then(startWith(Set(0), Set(0))).then(registerWaitWith(Set(0), Set(0)))
    .then(takeEventWith(Set(0), Set(0), Set(0), Set(0)))
    .then(takeEventWith(Set(0), Set(1), Set(0), Set(0)))
    .then(deliverWith(Set(0), Set(0))).then(deliverWith(Set(0), Set(0)))
    .then(takeEventWith(Set(0), Set(0), Set(0), Set(2)))
    .then(tickWith(Set(30000))).then(claimWith(Set(0), Set(1)))
    .then(takeEventWith(Set(1), Set(0), Set(0), Set(0)))
    .then(deliverWith(Set(0), Set(0))).then(finishWith(Set(1), Set(3), Set(0)))
    .then(claimWith(Set(0), Set(1))).then(takeEventWith(Set(1), Set(1), Set(0), Set(0)))
    .expect(listenersWitness and s.db.runs.nth(0).taken == [0,1,-1] and safety)

  run childTest = init.then(saveVersion).then(activateWith(Set(1)))
    .then(startWith(Set(0), Set(0))).then(startChildWith(Set(0), Set(1), Set(0)))
    .then(releaseWith(Set(0))).then(tickWith(Set(30000)))
    .then(claimWith(Set(1), Set(1))).then(finishWith(Set(1), Set(4), Set(2)))
    .then(claimWith(Set(0), Set(0))).then(startChildWith(Set(0), Set(1), Set(0)))
    .then(takeEventWith(Set(0), Set(0), Set(1), Set(0)))
    .then(startChildWith(Set(0), Set(1), Set(0)))
    .expect(unleasedParentWitness and childNotificationUnique and safety)

  run breakerTest = init.then(saveVersion).then(activateWith(Set(1)))
    .then(startWith(Set(0), Set(0))).then(releaseWith(Set(0)))
    .then(saveVersion).then(activateWith(Set(2)))
    .then(startWith(Set(1), Set(0))).then(finishWith(Set(0), Set(5), Set(0)))
    .then(claimWith(Set(0), Set(0))).then(finishWith(Set(0), Set(5), Set(0)))
    .then(startWith(Set(2), Set(0))).then(finishWith(Set(0), Set(5), Set(2)))
    .expect(rollbackWitness and s.db.catalog.active == 1 and s.db.runs.nth(2).version == 2 and safety)

  run replayTest = init.then(saveVersion).then(activateWith(Set(1)))
    .then(startWith(Set(0), Set(0))).then(prepareWith(Set(0), Set(1), Set(0)))
    .then(notExecutedWith(Set(0))).then(prepareWith(Set(0), Set(1), Set(0)))
    .then(sendWith(Set(0))).then(responseWith(Set(0), Set(2), Set(2)))
    .then(tickWith(Set(30000))).then(claimWith(Set(0), Set(1)))
    .then(prepareWith(Set(1), Set(1), Set(0))).then(checkpointWith(Set(1), Set(1), Set(0)))
    .then(prepareWith(Set(1), Set(1), Set(0))).then(conflictWith(Set(1), Set(1)))
    .then(sweepWith(Set(0)))
    .expect(s.seen.contains("replay") and s.seen.contains("conflict") and safety)

  run beforeCommitTest = init.then(saveVersion).then(activateWith(Set(1)))
    .then(startWith(Set(0), Set(0))).then(prepareWith(Set(0), Set(0), Set(1)))
    .then(tickWith(Set(30000))).then(claimWith(Set(0), Set(1)))
    .then(prepareWith(Set(1), Set(0), Set(0))).then(sendWith(Set(1)))
    .then(responseWith(Set(1), Set(3), Set(0)))
    .expect(s.sent.nth(0).nth(0) == 1 and s.db.runs.nth(0).calls.nth(0) == 3 and safety)

  run staleFenceTest = init.then(saveVersion).then(activateWith(Set(1)))
    .then(startWith(Set(0), Set(0))).then(tickWith(Set(30000)))
    .then(renewWith(Set(0))).then(claimWith(Set(0), Set(1)))
    .then(renewWith(Set(0))).then(releaseWith(Set(0)))
    .then(takeEventWith(Set(0), Set(0), Set(0), Set(0)))
    .expect(currentFenceOnly and s.db.runs.nth(0).generation == 2 and safety)

  run admissionTest = init.then(saveVersion).then(activateWith(Set(1)))
    .then(admitWith(Set(0), Set(1), Set(0))).then(saveVersion).then(activateWith(Set(2)))
    .then(admitWith(Set(0), Set(2), Set(0))).then(startWith(Set(0), Set(0)))
    .then(claimWith(Set(0), Set(0)))
    .expect(s.db.runs.nth(0).version == 1 and s.db.runs.nth(0).input == 1 and safety)

  run readRetryTest = init.then(saveVersion).then(activateWith(Set(1)))
    .then(startWith(Set(0), Set(0))).then(prepareWith(Set(0), Set(2), Set(0)))
    .then(sendWith(Set(0))).then(crashWith(Set(0))).then(tickWith(Set(30000)))
    .then(claimWith(Set(0), Set(1))).then(prepareWith(Set(1), Set(2), Set(0)))
    .then(sendWith(Set(1))).then(responseWith(Set(1), Set(2), Set(0)))
    .expect(s.sent.nth(0).nth(2) == 2 and safety)

  run cascadeTest = init.then(saveVersion).then(activateWith(Set(1)))
    .then(startWith(Set(0), Set(0))).then(startChildWith(Set(0), Set(1), Set(0)))
    .then(tickWith(Set(30000))).then(claimWith(Set(1), Set(1)))
    .then(startChildWith(Set(1), Set(2), Set(0)))
    .then(cancelWith(Set(0), Set(2))).then(cancelWith(Set(1), Set(0)))
    .expect(s.db.runs.nth(0).state == 6 and s.db.runs.nth(1).state == 6 and s.db.runs.nth(2).state == 6 and safety)

  run retentionTest = init.then(saveVersion).then(activateWith(Set(1)))
    .then(startWith(Set(0), Set(0))).then(prepareWith(Set(0), Set(0), Set(0)))
    .then(sweepWith(Set(0))).then(finishWith(Set(0), Set(3), Set(0)))
    .then(sweepWith(Set(0)))
    .expect(s.db.runs.nth(0).calls.nth(0) == 1 and safety)

  run successResetsBreakerTest = init.then(saveVersion).then(activateWith(Set(1)))
    .then(saveVersion).then(activateWith(Set(2)))
    .then(startWith(Set(0), Set(0))).then(finishWith(Set(0), Set(5), Set(0)))
    .then(startWith(Set(1), Set(0))).then(finishWith(Set(0), Set(4), Set(0)))
    .then(startWith(Set(2), Set(0))).then(finishWith(Set(0), Set(5), Set(0)))
    .expect(s.db.catalog.active == 2 and s.db.catalog.faults == 1 and safety)

  run interruptionTest = init.then(saveVersion).then(activateWith(Set(1)))
    .then(startWith(Set(0), Set(0)))
    .then(finishWith(Set(0), Set(7), Set(0)))
    .then(tickWith(Set(600000))).then(claimWith(Set(0), Set(0)))
    .then(finishWith(Set(0), Set(7), Set(0)))
    .then(tickWith(Set(600000))).then(claimWith(Set(0), Set(0)))
    .then(finishWith(Set(0), Set(7), Set(0)))
    .then(tickWith(Set(600000))).then(claimWith(Set(0), Set(0)))
    .then(finishWith(Set(0), Set(7), Set(0)))
    .then(tickWith(Set(600000))).then(claimWith(Set(0), Set(0)))
    .then(finishWith(Set(0), Set(7), Set(0)))
    .then(tickWith(Set(600000))).then(claimWith(Set(0), Set(0)))
    .then(finishWith(Set(0), Set(7), Set(0)))
    .then(tickWith(Set(600000))).then(claimWith(Set(0), Set(0)))
    .then(finishWith(Set(0), Set(7), Set(0)))
    .then(tickWith(Set(600000))).then(claimWith(Set(0), Set(0)))
    .then(finishWith(Set(0), Set(7), Set(0)))
    .then(tickWith(Set(600000))).then(claimWith(Set(0), Set(0)))
    .then(finishWith(Set(0), Set(7), Set(0)))
    .then(tickWith(Set(600000))).then(claimWith(Set(0), Set(0)))
    .then(finishWith(Set(0), Set(7), Set(0)))
    .expect(s.db.runs.nth(0).state == 5 and s.db.runs.nth(0).interruptions == 10 and safety)
}

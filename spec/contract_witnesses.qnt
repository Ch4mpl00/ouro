module contract_witnesses {
  import contract.* from "./contract"
  export contract.*
  action do(op: str): bool = execute(op,0,0,0,0,0)
  action boot = do("admit").then(do("claim"))
  action call = do("intent").then(do("dispatch")).then(do("result"))
  run continuationTest = init.then(boot).then(call).then(do("checkpoint")).then(do("recover"))
    .expect(checked and m.db.runs.nth(0).frontier == Set(0))
  run unknownTest = init.then(boot).then(execute("intent",0,0,0,0,2))
    .then(do("tick")).then(do("tick")).then(do("tick")).then(do("tick"))
    .then(do("claim")).then(do("recover")).expect(checked and m.observations.nth(m.observations.length()-1).result == 3)
  run mailboxTest = init.then(boot).then(do("address")).then(do("subscribe"))
    .then(do("take")).then(do("address")).then(execute("address",0,0,0,1,0))
    .expect(checked and m.db.copies.length() == 1 and m.observations.nth(m.observations.length()-1).result == -1)
  run expiryTest = init.then(boot).then(do("address"))
    .then(do("tick")).then(do("tick")).then(do("tick")).then(do("tick")).then(do("tick"))
    .then(do("expire")).expect(checked and m.db.copies.nth(0).disposition == 2)
  run childTest = init.then(boot).then(do("child")).then(do("cancel"))
    .expect(checked and m.db.runs.nth(1).notified and m.db.runs.nth(1).outcome == 5)
  run activationTest = init.then(boot).then(do("activate")).then(do("finish"))
    .expect(checked and m.db.catalog.epoch == 2 and m.db.runs.nth(0).epoch == 1)
  run deadlineTest = init.then(boot).then(do("crash"))
    .then(do("tick")).then(do("tick")).then(do("tick")).then(do("tick"))
    .then(do("tick")).then(do("tick")).then(do("tick")).then(do("tick"))
    .then(do("timeout")).expect(checked and m.db.runs.nth(0).outcome == 3 and m.db.runs.nth(0).deadline == 8)
  run compatibilityTest = init.then(execute("admit",0,0,1,0,0)).then(execute("claim",0,1,0,0,0))
    .expect(checked and m.db.runs.nth(0).owner == -1)
  run dryTest = init.then(do("dry")).then(do("claim")).then(call)
    .expect(checked and m.sends == [[0,0],[0,0]])
  run replayTest = init.then(do("replay")).then(do("claim")).then(call)
    .expect(checked and m.sends == [[0,0],[0,0]])
  run scheduleTest = init.then(do("tick")).then(do("tick")).then(do("fire"))
    .then(do("fire")).expect(checked and m.db.admissions == [1,0] and m.db.fired == Set((1,0)))
  run breakerTest = init.then(boot).then(execute("finish",0,0,0,1,0))
    .then(execute("admit",1,0,0,0,0)).then(execute("claim",1,0,0,0,0))
    .then(execute("finish",1,0,0,3,0)).expect(checked and m.db.catalog.tripped)
  run rearmTest = init.then(execute("activate",0,0,0,2,0)).then(do("tick")).then(do("tick"))
    .then(do("fire")).then(do("claim")).then(do("finish"))
    .expect(checked and m.db.catalog.due == 4 and m.db.catalog.rearm)
  run noCatchupTest = init.then(execute("activate",0,0,0,1,0))
    .then(do("tick")).then(do("tick")).then(do("tick")).then(do("fire"))
    .expect(checked and m.db.admissions == [0,0] and m.db.skipped == Set((2,0)))
  run overlapTest = init.then(do("tick")).then(do("tick")).then(do("fire"))
    .then(do("tick")).then(do("tick")).then(execute("fire",1,0,0,0,0))
    .expect(checked and m.db.admissions == [1,0] and m.db.skipped == Set((1,1)))
  run ingressTest = init.then(do("ingress")).then(execute("ingress",1,0,0,0,0))
    .then(execute("ingress",1,0,0,1,0))
    .expect(checked and m.db.admissions == [1,0] and m.observations.nth(m.observations.length()-1).result == -1)
  run ingressExpiryTest = init.then(do("ingress"))
    .then(do("tick")).then(do("tick")).then(do("tick")).then(do("tick")).then(do("tick"))
    .then(execute("ingress",1,0,0,0,0)).expect(checked and m.db.admissions == [1,1])
}

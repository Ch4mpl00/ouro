      "error": "unbound substitution: ${missing}"
    },
    {
      "value": "${empty}",
      "ok": true,
      "result": ""
    },
    {
      "value": {
        "x": [
          "${list.0}",
          "${env.items.1}",
          "${literal}"
        ]
      },
      "ok": true,
      "result": {
        "x": [
          1,

      "constructor": "own"
    },
    "list": [
      1,
      {
        "text": "two"
      }
    ],
    "empty": "",
    "literal": "${missing}"
  },
  "cases": [
    {
      "value": "${env}",
      "ok": true,
      "result": {
        "items": [
          {
            "title": "a"
          },
          null
        ],
        "nothing": null,
        "constructor": "own"
      }

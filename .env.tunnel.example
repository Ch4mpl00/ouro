# Credentials for the `tunnel-client` container (OpenAI Secure MCP Tunnel).
# Copy to .env.tunnel and fill in. .env.tunnel is git-ignored — never commit it.
#
# Create the tunnel at the OpenAI Platform → tunnel settings. Creating/editing
# a tunnel needs an API key with Tunnels "Read" + "Manage"; that key is NOT
# what goes here.

# The tunnel to attach to, from Platform tunnel settings.
# Format: tunnel_<32 hex chars>
CONTROL_PLANE_TUNNEL_ID=""

# Runtime API key for the daemon. Must be a RESTRICTED key with Tunnels
# "Read" + "Use" only. Do not use an admin key or an all-access key here —
# this process runs unattended for months. (OPENAI_ADMIN_KEY exists for
# tunnel CRUD from a shell; it is deliberately absent from this file.)
CONTROL_PLANE_API_KEY=""

# Everything else is set in docker-compose.yml:
#   MCP_SERVER_URL=http://mcp-tunnel:3001/mcp
#   LOG_LEVEL / LOG_FORMAT
# Defaults that are intentionally left alone:
#   CONTROL_PLANE_BASE_URL=https://api.openai.com
#   HEALTH_LISTEN_ADDR=127.0.0.1:8080  (container-local; not published)

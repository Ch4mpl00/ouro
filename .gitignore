.env
.env.local
.env.mcp
.env.agent
.env.postgres
*.log

# Local attachment / blob storage
storage/

# Golden sets for the evals (news-filter-eval): real channel posts and
# labels, kept per-machine.
/eval-fixtures/

# Live (runtime) skills — mutable, edited by the `dreaming` signal-handler.
# Defaults checked in under skills.default/ act as fallback when a live
# file is absent.
/skills/

# The agent's sqlite state (agent.db and friends; migrations live in
# crates/agent/migrations), and the improver's audit log beside it.
packages/*/data/

# OS / editor
.DS_Store
.idea/
.vscode/

# Claude Code runtime artefacts (we commit .claude/tasks/* by hand,
# but not lock files / session state).
.claude/scheduled_tasks.lock
.claude/projects/

# Rust build output
/target/

# Deployment/test Python helpers
__pycache__/

# Rust MCP local state
crates/*/data/

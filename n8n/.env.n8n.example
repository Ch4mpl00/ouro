# Copy to n8n/.env.n8n. Only the n8n service reads this file; the MCP instance
# beside it keeps using the root .env.mcp.

# Encrypts the credentials n8n stores in its own database. Generate once and
# never change it — a new key makes every stored credential unreadable:
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=""

# Owner account is created in the editor on first visit; these only matter if
# you want the instance to start out claimed.
# N8N_USER_MANAGEMENT_DISABLED=false

# Cron timezone for the digest (also pinned in the workflow's own settings).
N8N_TIMEZONE="Europe/Kyiv"

# Model credentials are NOT set here. n8n keeps provider keys in its own
# encrypted credential store, created once in the editor:
#   - "OpenAI account"        → the map phase (gpt-5.4-mini)
#   - "Google Gemini account" → the reduce phase (gemini-3.7-flash)
# Use the same keys as .env.agent (OPENAI_API_KEY / GEMINI_API_KEY).

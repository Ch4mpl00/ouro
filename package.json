{
  "name": "mcp-tools",
  "version": "0.1.0",
  "description": "Personal-agent system: an MCP server (integrations) + an agent supervisor (signal-driven, DB-backed).",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "mcp:serve": "cargo run -q --release -p mcp-tools --bin mcp-tools --",
    "codex:serve": "tsx packages/codex/src/server.ts",
    "agent:start": "tsx packages/agent/src/supervisor/main.ts",
    "trace": "tsx packages/agent/src/scripts/langfuse-trace.ts",
    "judge": "tsx packages/agent/src/scripts/judge.ts",
    "judge:worker": "tsx packages/agent/src/scripts/judge-worker.ts",
    "judge:noise": "tsx packages/agent/src/scripts/judge-noise.ts",
    "judge:gate": "tsx packages/agent/src/scripts/judge-gate.ts",
    "improve": "tsx packages/agent/src/scripts/improve.ts",
    "improve:worker": "tsx packages/agent/src/scripts/improve-worker.ts",
    "bench:gaia": "tsx packages/agent/src/eval/benchmarks/gaia/run.ts",
    "db:init": "pnpm db:init:mcp && pnpm db:init:agent",
    "db:init:mcp": "cargo run -q --release -p mcp-tools --bin mcp-setup --",
    "db:init:agent": "pnpm setup:agent",
    "setup": "pnpm setup:mcp && pnpm setup:agent",
    "setup:mcp": "cargo run -q --release -p mcp-tools --bin mcp-setup --",
    "setup:agent": "tsx packages/agent/src/scripts/setup.ts",
    "gmail:auth": "cargo run -q --release -p mcp-tools --bin gmail-auth --",
    "gmail:list-unread": "cargo run -q --release -p mcp-tools --bin gmail-list-unread --",
    "telegram:get-chat-id": "cargo run -q --release -p mcp-tools --bin telegram-get-chat-id --",
    "userbot:auth": "cargo run -q --release -p mcp-tools --bin userbot-auth --",
    "monobank:txns": "cargo run -q --release -p mcp-tools --bin monobank-txns --",
    "db:generate:agent": "pnpm --filter @mcp-tools/agent exec drizzle-kit generate",
    "db:migrate:channel-posts": "cargo run -q --release -p mcp-tools --bin migrate-channel-posts --",
    "memory:import-notes": "cargo run -q --release -p mcp-tools --bin memory-import-notes --",
    "embed:backfill": "cargo run -q --release -p mcp-tools --bin embed-backfill --",
    "eval:snapshot": "cargo run -q --release -p mcp-tools --bin eval-snapshot --",
    "eval:rag": "cargo run -q --release -p mcp-tools --bin eval-rag --",
    "eval:inspect": "cargo run -q --release -p mcp-tools --bin eval-inspect --",
    "test": "vitest run",
    "test:mcp": "cargo test -p mcp-tools",
    "deploy": "scripts/deploy.sh",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.8"
  }
}
